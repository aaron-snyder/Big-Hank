# Copy this file to ".env" and fill in your values.
# .env is git-ignored, so your token never ends up on GitHub.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-token-here

# Optional: where player progress is saved (default: data/inventories.json)
# DATA_FILE=data/inventories.json
